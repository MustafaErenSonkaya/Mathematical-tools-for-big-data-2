  {
   "id": 7,
   "type": "timeseries",
   "title": "Signal $sensor: raw (with injected anomalies) vs clean",
   "description": "Raw = what the detectors see. Where the two lines differ an anomaly was injected.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sensor_value{sensor=\"$sensor\", series=\"raw\"}",
     "legendFormat": "raw (injected)",
     "refId": "A",
     "range": true
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sensor_value{sensor=\"$sensor\", series=\"clean\"}",
     "legendFormat": "clean (original)",
     "refId": "B",
     "range": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "custom": {
      "lineWidth": 1,
      "showPoints": "never",
      "spanNulls": false,
      "axisLabel": ""
     },
     "color": {
      "mode": "palette-classic"
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byRegexp",
       "options": "raw.*"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#d62728"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byRegexp",
       "options": "clean.*"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#1f77b4"
        }
       }
      ]
     }
    ]
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi",
     "sort": "none"
    }
   }
  },
  {
   "id": 8,
   "type": "state-timeline",
   "title": "Injected events vs alarms ($sensor)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "description": "Top rows: injected events by kind. Lower rows: alarms of each method on this sensor. Flags stay on for 2 s so the 1 s scrape cannot miss them.",
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max by (kind) (injected_event_active{sensor=\"$sensor\"})",
     "legendFormat": "injected {{kind}}",
     "refId": "A",
     "range": true
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max by (method) (detector_alarm{sensor=\"$sensor\", method=~\"$method\"})",
     "legendFormat": "alarm {{method}}",
     "refId": "B",
     "range": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "transparent",
        "value": null
       },
       {
        "color": "#d62728",
        "value": 0.5
       }
      ]
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byRegexp",
       "options": "injected.*"
      },
      "properties": [
       {
        "id": "thresholds",
        "value": {
         "mode": "absolute",
         "steps": [
          {
           "color": "transparent",
           "value": null
          },
          {
           "color": "#ff9830",
           "value": 0.5
          }
         ]
        }
       }
      ]
     }
    ]
   },
   "options": {
    "showValue": "never",
    "rowHeight": 0.8,
    "mergeValues": true,
    "alignValue": "left",
    "legend": {
     "showLegend": false
    }
   }
  },
  {
   "id": 9,

{
 "uid": "cmapss-detect",
 "title": "Sequential change detection",
 "tags": [
  "cmapss",
  "cusum",
  "ewma"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "editable": false,
 "graphTooltip": 1,
 "refresh": "1s",
 "time": {
  "from": "now-5m",
  "to": "now"
 },
 "timepicker": {
  "refresh_intervals": [
   "1s",
   "2s",
   "5s",
   "10s",
   "30s"
  ]
 },
 "templating": {
  "list": [
   {
    "name": "sensor",
    "label": "sensor",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "query": {
     "query": "label_values(sensor_value, sensor)",
     "refId": "sensor"
    },
    "definition": "label_values(sensor_value, sensor)",
    "refresh": 1,
    "sort": 3,
    "current": {
     "text": "s4",
     "value": "s4"
    }
   },
   {
    "name": "method",
    "label": "method",
    "type": "custom",
    "multi": true,
    "includeAll": true,
    "query": "shewhart,sprt,cusum,ewma,mewma",
    "allValue": "shewhart|sprt|cusum|ewma|mewma",
    "current": {
     "text": [
      "All"
     ],
     "value": [
      "$__all"
     ]
    },
    "options": [
     {
      "text": "All",
      "value": "$__all",
      "selected": true
     },
     {
      "text": "shewhart",
      "value": "shewhart",
      "selected": false
     },
     {
      "text": "sprt",
      "value": "sprt",
      "selected": false
     },
     {
      "text": "cusum",
      "value": "cusum",
      "selected": false
     },
     {
      "text": "ewma",
      "value": "ewma",
      "selected": false
     },
     {
      "text": "mewma",
      "value": "mewma",
      "selected": false
     }
    ]
   }
  ]
 },
 "annotations": {
  "list": []
 },
